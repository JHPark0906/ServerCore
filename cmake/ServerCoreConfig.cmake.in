@PACKAGE_INIT@

# Reject unsupported targets before exposing native library dependencies.
if (NOT WIN32 AND NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
    set(ServerCore_FOUND FALSE)
    set(ServerCore_NOT_FOUND_MESSAGE "ServerCore supports Windows and Linux.")
    return()
endif ()

include(CMakeFindDependencyMacro)
if (EXISTS "${CMAKE_CURRENT_LIST_DIR}/ServerCoreTargets.cmake")
    find_dependency(Threads)
    include("${CMAKE_CURRENT_LIST_DIR}/ServerCoreTargets.cmake")
    set(ServerCore_Core_FOUND TRUE)
else ()
    set(ServerCore_Core_FOUND FALSE)
    if (NOT ServerCore_FIND_COMPONENTS)
        set(ServerCore_FOUND FALSE)
        set(ServerCore_NOT_FOUND_MESSAGE "This prefix contains only the CAbi component; request COMPONENTS CAbi.")
        return()
    endif ()
endif ()
foreach(component IN LISTS ServerCore_FIND_COMPONENTS)
    if (component STREQUAL "CAbi" AND EXISTS "${CMAKE_CURRENT_LIST_DIR}/ServerCoreCAbiTargets.cmake")
        include("${CMAKE_CURRENT_LIST_DIR}/ServerCoreCAbiTargets.cmake")
        set(ServerCore_CAbi_FOUND TRUE)
    elseif (NOT component STREQUAL "Core")
        set(ServerCore_${component}_FOUND FALSE)
    endif ()
endforeach ()
check_required_components(ServerCore)
