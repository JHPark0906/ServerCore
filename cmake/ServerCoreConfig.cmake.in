@PACKAGE_INIT@

# Reject unsupported targets before exposing native library dependencies.
if (NOT WIN32 AND NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
    set(ServerCore_FOUND FALSE)
    set(ServerCore_NOT_FOUND_MESSAGE "ServerCore supports Windows and Linux.")
    return()
endif ()

include(CMakeFindDependencyMacro)
find_dependency(Threads)

include("${CMAKE_CURRENT_LIST_DIR}/ServerCoreTargets.cmake")
check_required_components(ServerCore)
